# Configuracion gym — access + torniquete
# Copiar a access/backend/.env si hace falta (ya existe SITE_ID=gym)

# Torniquete ESP32 (DoorController HTTP con Bearer)
TORNIQUETE_HOST=192.168.100.119
TORNIQUETE_TOKEN=<TORNIQUETE_TOKEN>
TORNIQUETE_CONTROLLER_REF=POST http://192.168.100.119/api/open|||Authorization: Bearer <TORNIQUETE_TOKEN>

# Facial chino (camara ingreso)
FACIAL_HOST=192.168.100.200
FACIAL_WEB=http://192.168.100.200/
FACIAL_USER=admin
FACIAL_PASS=admin

# Access stack
ACCESS_URL=http://localhost:3010
ACCESS_ADMIN=<ACCESS_ADMIN_EMAIL>
ACCESS_ADMIN_PASS=<ACCESS_PASSWORD>
