	<SimpleCodeList>
		<Row>
			<Value ColumnRef="code">
				<SimpleValue>05</SimpleValue>
			</Value>
			<Value ColumnRef="name">
				<SimpleValue>Documento Soporte en adquisiciones efectuadas a sujetos no obligados a expedir factura de venta o documento equivalente</SimpleValue>
			</Value>
		</Row>
