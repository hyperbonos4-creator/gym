# Copia como .env y completa tras flashear el ESP32

# ── Torniquete ESP32 ──────────────────────────────────────────────────────────
TORNIQUETE_HOST=192.168.1.100
TORNIQUETE_TOKEN=gym-secret-token
TORNIQUETE_SERIAL=COM3

# ── Access API (backend access en Docker) ────────────────────────────────────
# URL base del backend (sin trailing slash)
ACCESS_API_URL=http://localhost:3000

# Credenciales del usuario ADMIN o OPERATOR del backend
ACCESS_API_EMAIL=admin@office.local
ACCESS_API_PASSWORD=ChangeMe123!

# UUID del punto de acceso que corresponde al torniquete.
# Obtenerlo con:  GET /api/v1/access/points  (requiere login)
# O desde Swagger: http://localhost:3000/api/docs
ACCESS_POINT_ID=

# ── IP Cam en torniquete (opcional) ──────────────────────────────────────────
# Solo necesaria si el facial chino NO envía la foto en el VerifyPush.
# Si usas "w/captured image" en el facial, esta variable puede quedarse vacía.
#
# Ejemplos:
#   Hikvision: http://admin:password@192.168.100.xxx/ISAPI/Streaming/channels/101/picture
#   Dahua:     http://admin:password@192.168.100.xxx/cgi-bin/snapshot.cgi
#   Genérica:  http://192.168.100.xxx/snapshot.jpg
IP_CAM_URL=

# ── Plataforma Docker + túnel fijo ──────────────────────────────────────────
# Token de ngrok (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=sappy-drool-monument.ngrok-free.dev
ENROLL_PUBLIC_BASE=https://sappy-drool-monument.ngrok-free.dev

