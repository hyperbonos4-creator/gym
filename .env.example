# Copia como .env y completa. NUNCA subas .env al repositorio.

# ── Sesión del panel (gym-web) ──────────────────────────────────────────────
SESSION_SECRET=                    # obligatorio en producción (≥32 caracteres)
SESSION_TTL_HOURS=24
GYM_BOOTSTRAP_ADMIN_USER=          # solo si no existe data/users.json
GYM_BOOTSTRAP_ADMIN_PASSWORD=      # ≥8; quitar tras el primer arranque
GYM_BOOTSTRAP_ADMIN_NAME=Administrador
ALLOW_PUBLIC_REGISTRO=false
MOBILE_OTP_REQUIRED=true
ENROLL_CODE_TTL_HOURS=24

# ── Torniquete ESP32 ────────────────────────────────────────────────────────
TORNIQUETE_HOST=192.168.1.100
TORNIQUETE_TOKEN=                  # genera uno largo; sin default
TORNIQUETE_SERIAL=COM3

# ── Access API (backend access) ─────────────────────────────────────────────
ACCESS_API_URL=http://localhost:3010
ACCESS_URL=http://127.0.0.1:3010
ACCESS_API_EMAIL=
ACCESS_API_PASSWORD=
ACCESS_ADMIN_EMAIL=
ACCESS_ADMIN_PASS=
ACCESS_POINT_ID=

# ── IP Cam (opcional) ───────────────────────────────────────────────────────
IP_CAM_URL=

# ── Facial webhook ──────────────────────────────────────────────────────────
FACIAL_WEBHOOK_HOST=127.0.0.1
FACIAL_WEBHOOK_PORT=8787
FACIAL_WEBHOOK_TOKEN=
FACIAL_WEBHOOK_ALLOW_IPS=

# ── ESP agent (puente local) ────────────────────────────────────────────────
ESP_AGENT_KEY=
ESP_AGENT_HOST=127.0.0.1
ESP_AGENT_PORT=3190
ESP_AGENT_CORS_ORIGIN=http://127.0.0.1:3100

# ── Plataforma / túnel ──────────────────────────────────────────────────────
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
ENROLL_PUBLIC_BASE=

# ── WhatsApp (Evolution) ────────────────────────────────────────────────────
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_KEY=

# ── Access Postgres ─────────────────────────────────────────────────────────
DB_USER=access
DB_PASSWORD=                       # obligatorio (compose falla si falta)
DB_NAME=access_control
DB_SYNCHRONIZE=false               # true solo en desarrollo

# ── Access seed ─────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=               # ≥12 caracteres
JWT_ACCESS_SECRET=                 # ≥16; access backend
ENROLL_TOKEN_TTL=15m

# ── Pagos / DIAN (opcionales) ───────────────────────────────────────────────
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_PRIVATE_KEY=
DIAN_CERT_PASSWORD=

# --- Tunel camara (access/tunnel.ps1) ---
# Solo placeholders; valores reales van en tu .env local o en el entorno de Windows.
GYM_TUNNEL_SERVER=                 # ej. root@TU_SERVIDOR_O_IP
GYM_CAMERA_HOST=                   # ej. 192.168.1.10
GYM_TUNNEL_SSH_KEY=                # ruta a la llave privada SSH
GYM_CAM_PUBLIC_URL=                # opcional: https://cam.ejemplo.sslip.io/

# Publicacion de puertos (default 127.0.0.1; 0.0.0.0 solo en PC local de LAN)
GYM_WEB_BIND=127.0.0.1
ACCESS_BIND=127.0.0.1
COOKIE_SECURE=                     # true detras de HTTPS
